---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import PostNav from "@/components/PostNav.astro";
import { IconHome } from "@tabler/icons-astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => (import.meta.env.PROD ? !data.draft : true))).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
  );
  const toLink = (p?: (typeof posts)[number]) => (p ? { id: p.id, title: p.data.title } : undefined);
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, prev: toLink(posts[i - 1]), next: toLink(posts[i + 1]) },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
---

<Layout title={post.data.title} description={post.data.description} ogImage={`/og/${post.id}.png`}>
  <div class="mx-auto max-w-6xl">
    <section class="py-16 px-6">
      <div class="flex flex-col items-start text-left space-y-4">
        <div class="flex flex-row items-center justify-start w-full space-x-2">
          <a href="/" class="text-left" aria-label="ホーム">
            <IconHome size="16" />
          </a>
          <span class="text-zinc-400" aria-hidden="true">/</span>
          <a href="/blog" class="text-left">
            Blog
          </a>
          <span class="text-zinc-400" aria-hidden="true">/</span>
          <span class="line-clamp-1 text-left text-zinc-600" aria-current="page">
            {post.data.title}
          </span>
        </div>
        <p class="text-sm text-zinc-600">
          {post.data.date.toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" })}
        </p>
        <h1 class="text-2xl font-bold lg:text-4xl">{post.data.title}</h1>
        <p class="text-lg font-semibold text-zinc-700">{post.data.description}</p>
      </div>
    </section>
    <section class="px-6 lg:grid lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-10">
      <div class="mb-8 lg:hidden">
        <TableOfContents headings={headings} />
      </div>
      <div class="min-w-0 max-w-none prose prose-zinc prose-a:text-zinc-900 prose-a:decoration-orange-500 prose-a:decoration-2 prose-a:underline-offset-4 prose-img:rounded-xl prose-img:shadow-sm [&_iframe]:w-full [&_iframe]:max-w-full [&_iframe]:aspect-video [&_iframe]:rounded-xl">
        <Content />
      </div>
      <aside class="hidden lg:block">
        <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </section>
    <section class="px-6 pt-16">
      <PostNav prev={prev} next={next} />
    </section>
  </div>
</Layout>

<script>
  type HoverCardData = { title?: string; description?: string; image?: string; favicon?: string; host: string };

  if (matchMedia("(hover: hover)").matches) {
    const card = document.createElement("div");
    card.className = "hover-card";
    card.setAttribute("role", "tooltip");
    card.id = "hover-card";
    document.body.append(card);

    let showTimer: number | undefined;
    let hideTimer: number | undefined;
    let current: HTMLAnchorElement | null = null;

    const el = (tag: string, className: string, text?: string) => {
      const node = document.createElement(tag);
      node.className = className;
      if (text) node.textContent = text;
      return node;
    };

    const render = (data: HoverCardData) => {
      card.replaceChildren();
      if (data.image) {
        const image = el("img", "hover-card__image") as HTMLImageElement;
        image.src = data.image;
        image.alt = "";
        image.loading = "lazy";
        card.append(image);
      }
      const body = el("div", "hover-card__body");
      if (data.title) body.append(el("span", "hover-card__title", data.title));
      if (data.description) body.append(el("span", "hover-card__description", data.description));
      const meta = el("div", "hover-card__meta");
      if (data.favicon) {
        const favicon = el("img", "hover-card__favicon") as HTMLImageElement;
        favicon.src = data.favicon;
        favicon.alt = "";
        meta.append(favicon);
      }
      meta.append(el("span", "", data.host));
      body.append(meta);
      card.append(body);
    };

    const place = (anchor: HTMLElement) => {
      const rect = anchor.getBoundingClientRect();
      const { width, height } = card.getBoundingClientRect();
      const gap = 8;
      const left = Math.min(Math.max(16, rect.left), window.innerWidth - width - 16);
      const below = rect.bottom + gap + height <= window.innerHeight || rect.top - gap - height < 0;
      card.style.left = `${left}px`;
      card.style.top = `${below ? rect.bottom + gap : rect.top - gap - height}px`;
    };

    const show = (anchor: HTMLAnchorElement) => {
      let data: HoverCardData;
      try {
        data = JSON.parse(anchor.dataset.hoverCard ?? "");
      } catch {
        return;
      }
      current = anchor;
      render(data);
      place(anchor);
      anchor.setAttribute("aria-describedby", card.id);
      card.dataset.open = "";
    };

    const hide = () => {
      current?.removeAttribute("aria-describedby");
      current = null;
      delete card.dataset.open;
    };

    const schedule = (anchor: HTMLAnchorElement) => {
      clearTimeout(hideTimer);
      clearTimeout(showTimer);
      showTimer = window.setTimeout(() => show(anchor), current ? 0 : 250);
    };

    const leave = () => {
      clearTimeout(showTimer);
      hideTimer = window.setTimeout(hide, 100);
    };

    const target = (event: Event) => (event.target as Element).closest<HTMLAnchorElement>("a[data-hover-card]");

    document.addEventListener("mouseover", (event) => {
      const anchor = target(event);
      if (anchor) schedule(anchor);
    });
    document.addEventListener("mouseout", (event) => {
      if (target(event)) leave();
    });
    document.addEventListener("focusin", (event) => {
      const anchor = target(event);
      if (anchor) schedule(anchor);
    });
    document.addEventListener("focusout", (event) => {
      if (target(event)) leave();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") hide();
    });
    window.addEventListener("scroll", hide, { passive: true });
  }
</script>
