---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => (import.meta.env.PROD ? !data.draft : true))).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="すべての記事" description="このブログのすべての記事">
  <div class="mx-auto max-w-6xl">
    <section class="py-16 px-6">
      <div class="flex flex-col gap-4">
        <h1 class="text-3xl lg:text-5xl font-bold">すべての記事</h1>
        <p class="text-lg text-zinc-700">これまでに投稿した記事の一覧です。</p>
      </div>
    </section>
    <section class="py-8 px-6">
      <div class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {posts.map((p) => (
          <a
            href={`/blog/${p.id}`}
            class="flex flex-col rounded-xl p-4 border border-zinc-200 space-y-2 transition-colors hover:border-zinc-600"
          >
            <p class="text-sm text-zinc-600">
              {p.data.date.toLocaleDateString("ja-jp", { year: "numeric", month: "2-digit", day: "2-digit" })}
            </p>
            <h2 class="text-xl font-semibold">{p.data.title}</h2>
            <p class="text-sm font-medium text-zinc-700 line-clamp-3">{p.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
