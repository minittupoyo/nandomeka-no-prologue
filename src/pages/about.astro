---
import Layout from "@/layouts/Layout.astro";
import { IconBrandX, IconBrandGithub, IconMusic } from "@tabler/icons-astro";
import { LISTENBRAINZ_USER } from "@/const";
---

<Layout title="About" description="このブログと運営者について。">
  <div class="mx-auto max-w-3xl">
    <section class="py-32 px-6">
      <div class="flex flex-col gap-4">
        <h1 class="text-3xl lg:text-5xl font-bold">About</h1>
        <p class="text-lg text-zinc-700">自宅サーバーとLinux、たまにプログラミング。</p>
      </div>
    </section>
    <section class="px-6 space-y-12">
      <div class="space-y-3">
        <h2 class="text-xl font-semibold">このブログについて</h2>
        <p class="text-zinc-700">
          「何度目かのプロローグ」は、自宅サーバーの運用やLinuxの環境構築、プログラミングについて書いている個人ブログです。
        </p>
      </div>
      <div class="space-y-3">
        <h2 class="text-xl font-semibold">運営者</h2>
        <p class="text-zinc-700">みにっつ (minittu)。岩手在住。未来永劫、初心者。</p>
        <p class="text-zinc-700">JavaScript、HTML、CSS、Astro、Next.js、Cloudflare、Docker あたりを触っています。</p>
      </div>
      <div class="space-y-3">
        <h2 class="text-xl font-semibold">作ったもの</h2>
        <ul class="space-y-2 text-zinc-700">
          <li>
            <a href="https://github.com/minittupoyo/aria2gui" target="_blank" class="link-inline">aria2gui</a>
            : Aria2をGUIで使えるようにしたやつ
          </li>
          <li>
            <a href="https://github.com/minittupoyo/dotfiles" target="_blank" class="link-inline">dotfiles</a>
            : My Desktop
          </li>
        </ul>
      </div>
      <div class="space-y-3">
        <h2 class="text-xl font-semibold">リンク</h2>
        <ul class="space-y-2">
          <li>
            <a href="https://x.com/dikndisk081" target="_blank" class="link-inline inline-flex items-center gap-2">
              <IconBrandX size="16" />X
            </a>
          </li>
          <li>
            <a href="https://github.com/minittupoyo" target="_blank" class="link-inline inline-flex items-center gap-2">
              <IconBrandGithub size="16" />GitHub
            </a>
          </li>
        </ul>
      </div>
      <div id="listening" hidden class="space-y-3">
        <h2 class="text-xl font-semibold">最近聴いている曲</h2>
        <a
          id="listening-current"
          href={`https://listenbrainz.org/user/${LISTENBRAINZ_USER}/`}
          target="_blank"
          class="flex items-center gap-4 rounded-xl border border-zinc-200 p-4 text-zinc-900 no-underline transition-colors hover:border-zinc-600"
        >
          <div class="flex size-24 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-zinc-100 text-zinc-600">
            <img id="listening-cover" alt="" width="96" height="96" hidden class="size-full object-cover" />
            <IconMusic id="listening-cover-fallback" size="24" aria-hidden="true" />
          </div>
          <div class="min-w-0 space-y-1">
            <p id="listening-label" class="text-sm text-zinc-600"></p>
            <p id="listening-track" class="line-clamp-2 font-semibold"></p>
            <p id="listening-artist" class="truncate text-sm text-zinc-700"></p>
            <p id="listening-album" class="truncate text-sm text-zinc-600"></p>
          </div>
        </a>
        <div class="space-y-2">
          <h3 class="text-sm font-medium text-zinc-600">再生履歴</h3>
          <ul id="listening-history" class="divide-y divide-zinc-200 rounded-xl border border-zinc-200 text-sm"></ul>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { coverUrl, isSameTrack, lookupCoverUrl, subscribeNowPlaying, type Listen } from "@/lib/listenbrainz";

  const root = document.getElementById("listening");
  const el = (id: string) => document.getElementById(id)!;

  const relative = (sec?: number) => {
    if (!sec) return "";
    const diff = Math.round((sec * 1000 - Date.now()) / 60000);
    const rtf = new Intl.RelativeTimeFormat("ja", { numeric: "auto" });
    if (Math.abs(diff) < 60) return rtf.format(diff, "minute");
    if (Math.abs(diff) < 60 * 24) return rtf.format(Math.round(diff / 60), "hour");
    return rtf.format(Math.round(diff / 60 / 24), "day");
  };

  let shownTrack: Listen | undefined;

  const showCurrent = async (label: string, listen: Listen, coverFrom: Listen = listen) => {
    const m = listen.track_metadata;
    const changed = !shownTrack || !isSameTrack(shownTrack, listen);
    shownTrack = listen;
    el("listening-label").textContent = label;
    el("listening-track").textContent = m.track_name;
    el("listening-artist").textContent = m.artist_name;
    el("listening-album").textContent = m.release_name ?? "";

    const cover = el("listening-cover") as HTMLImageElement;
    const fallback = el("listening-cover-fallback");
    if (!changed) return;
    cover.hidden = true;
    fallback.removeAttribute("hidden");
    const url = coverUrl(listen) ?? coverUrl(coverFrom) ?? (await lookupCoverUrl(listen));
    if (url) {
      cover.onload = () => {
        cover.hidden = false;
        fallback.setAttribute("hidden", "");
      };
      cover.src = url;
    }
  };

  const showHistory = (listens: Listen[]) => {
    const list = el("listening-history");
    list.replaceChildren(
      ...listens.map((l) => {
        const li = document.createElement("li");
        li.className = "flex items-baseline justify-between gap-4 px-4 py-2";
        const title = document.createElement("span");
        title.className = "min-w-0 truncate";
        title.textContent = `${l.track_metadata.track_name} - ${l.track_metadata.artist_name}`;
        const time = document.createElement("span");
        time.className = "shrink-0 text-xs text-zinc-600";
        time.textContent = relative(l.listened_at);
        li.append(title, time);
        return li;
      }),
    );
  };

  subscribeNowPlaying((state) => {
    if (!root) return;
    const playing = state?.playing;
    const recent = state?.recent ?? [];
    if (playing) void showCurrent("再生中", playing, recent.find((l) => isSameTrack(l, playing)) ?? playing);
    else if (recent[0]) void showCurrent("最近聴いた曲", recent[0]);
    else return;
    showHistory(playing ? recent : recent.slice(1));
    root.hidden = false;
  });
</script>
