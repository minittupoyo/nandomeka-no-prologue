---
import { HEADER_LINK } from "@/const";

const pathname = Astro.url.pathname;
---

<header class="top-0 left-0 z-10 h-16 w-full bg-white/60 backdrop-blur-xl border-b border-zinc-100 sticky">
  <div class="mx-auto w-full max-w-6xl h-full flex flex-row items-center justify-between px-6">
    <a href="/" class="text-lg font-bold">
      何度目かのプロローグ
    </a>
    <div class="flex flex-row items-center gap-6">
      {HEADER_LINK.map((link) => (
        <a
          href={link.to}
          aria-current={pathname.startsWith(link.to) ? "page" : undefined}
          class="font-medium text-zinc-700 transition hover:text-zinc-900 aria-[current=page]:text-zinc-900 aria-[current=page]:underline aria-[current=page]:decoration-orange-500 aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>
