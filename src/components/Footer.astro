---
import { IconBrandX, IconBrandGithub, IconMusic } from "@tabler/icons-astro";
import { LISTENBRAINZ_USER } from "@/const";
---

<footer class="w-full border-t border-zinc-100">
  <div class="mx-auto max-w-6xl p-6 h-full flex flex-row items-center justify-between gap-6">
    <div class="min-w-0 flex flex-col gap-1">
      <a href="/" class="text-xs font-medium">
        &copy; 2026 minittu.
      </a>
      <a
        id="now-playing"
        href={`https://listenbrainz.org/user/${LISTENBRAINZ_USER}/`}
        target="_blank"
        data-user={LISTENBRAINZ_USER}
        hidden
        class="flex min-w-0 items-center gap-1 text-xs text-zinc-600 hover:text-zinc-900"
      >
        <IconMusic size="14" class="shrink-0" aria-hidden="true" />
        <span id="now-playing-label" class="shrink-0"></span>
        <span id="now-playing-track" class="truncate"></span>
      </a>
    </div>
    <div class="flex flex-row items-center gap-6">
      <a href="https://x.com/dikndisk081" target="_blank" aria-label="X">
        <IconBrandX size="16" />
      </a>
      <a href="https://github.com/minittupoyo" target="_blank" aria-label="GitHub">
        <IconBrandGithub size="16" />
      </a>
    </div>
  </div>
</footer>

<script>
  import { getListens, getPlayingNow, type Listen } from "@/lib/listenbrainz";

  const root = document.getElementById("now-playing") as HTMLAnchorElement | null;
  const label = document.getElementById("now-playing-label");
  const track = document.getElementById("now-playing-track");

  if (root && label && track) {
    const user = root.dataset.user!;
    const get = (path: string) => getListens(user, path);

    const show = (text: string, listen: Listen) => {
      const { track_name, artist_name } = listen.track_metadata;
      label.textContent = text;
      track.textContent = `${track_name} - ${artist_name}`;
      root.hidden = false;
    };

    const update = async () => {
      try {
        const playing = await getPlayingNow(user);
        if (playing) return show("再生中:", playing);
        const [recent] = await get("listens?count=1");
        if (recent) return show("最近聴いた曲:", recent);
      } catch {
        // 取得できないときは表示しない
      }
      root.hidden = true;
    };

    update();
    setInterval(() => {
      if (!document.hidden) update();
    }, 60_000);
  }
</script>
