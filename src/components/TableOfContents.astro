---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const headings = Astro.props.headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  headings.length > 0 && (
    <nav aria-label="目次" class="toc rounded-xl border border-zinc-100 bg-white p-4 text-sm">
      <p class="mb-2 font-bold text-zinc-900">目次</p>
      <ul class="space-y-1.5">
        {headings.map((h) => (
          <li class={h.depth === 3 ? "pl-4" : ""}>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class="block border-l-2 border-transparent pl-2 text-zinc-600 transition hover:text-zinc-900 data-[active=true]:border-zinc-900 data-[active=true]:font-medium data-[active=true]:text-zinc-900"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
  const targets = [...links]
    .map((a) => document.getElementById(a.dataset.tocLink!))
    .filter((el): el is HTMLElement => el !== null);

  if (targets.length > 0) {
    const setActive = (slug: string) => {
      links.forEach((a) => a.setAttribute("data-active", String(a.dataset.tocLink === slug)));
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length > 0) setActive(visible[0].target.id);
      },
      { rootMargin: "-80px 0px -70% 0px" },
    );
    targets.forEach((t) => observer.observe(t));
  }
</script>
